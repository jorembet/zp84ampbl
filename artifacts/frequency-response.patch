+    near(zp_cascade_response_db(&modes[ZP_RESPONSE_HPF],48000,100),-3.01029995664,1e-7);
+    near(zp_cascade_response_db(&modes[ZP_RESPONSE_LPF],48000,6000),-6.02059991328,1e-7);
