+
+zp_complex_response zp_cascade_response(const zp_cascade *c,double fs,double freq)
+{
+    if(!c||!response_frequency_valid(fs,freq)||c->count<0||c->count>ZP_MAX_STAGES)
+        return (zp_complex_response){NAN,NAN};
